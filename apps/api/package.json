{
  "name": "@tablia/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "db:setup": "tsx src/scripts/setup-db.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/integration.test.ts",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.0",
    "@tablia/shared": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.156",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.4"
  }
}
